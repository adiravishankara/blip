# Copy to .env and fill in values before: docker compose up
#
# SUPABASE: Run `npx supabase start` first. Use the URLs it prints.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your_anon_key_from_supabase_status

# FIRECRAWL: Self-hosted - no API key needed. URL for browser to reach Firecrawl.
VITE_FIRECRAWL_API_URL=http://localhost:3002/v2/scrape
VITE_FIRECRAWL_API_KEY=

# Optional: Ollama models for Firecrawl AI extraction (experimental)
# OLLAMA_MODEL_NAME=gemma3:1b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Firecrawl Postgres (internal)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Firecrawl queue admin UI: http://localhost:3002/admin/{BULL_AUTH_KEY}/queues
BULL_AUTH_KEY=CHANGEME
