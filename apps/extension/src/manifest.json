{
  "manifest_version": 3,
  "name": "Blip",
  "version": "0.0.0",
  "action": {
    "default_title": "Blip"
  },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "assets/options.html",
    "open_in_tab": true
  }
}

