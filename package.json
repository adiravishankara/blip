{
  "name": "blip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "dev:web": "turbo dev --filter=@blip/web",
    "build:web": "turbo build --filter=@blip/web",
    "lint:web": "turbo lint --filter=@blip/web",
    "typecheck:web": "turbo typecheck --filter=@blip/web",
    "dev:ext": "turbo dev --filter=@blip/extension",
    "build:ext": "turbo build --filter=@blip/extension",
    "lint:ext": "turbo lint --filter=@blip/extension",
    "typecheck:ext": "turbo typecheck --filter=@blip/extension"
  },
  "devDependencies": {
    "supabase": "^2.76.17",
    "turbo": "^2.5.6",
    "typescript": "^5.5.3"
  }
}
